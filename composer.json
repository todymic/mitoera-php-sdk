{
    "name": "mitoera/php-sdk",
    "description": "Official PHP SDK for the Mitoera seating platform",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mitoera\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mitoera\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
