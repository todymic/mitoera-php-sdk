{
    "name": "mitoera/php-sdk",
    "description": "Official PHP SDK for the Mitoera seating platform",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mitoera",
        "seating",
        "ticketing",
        "seatmap",
        "sdk",
        "api-client"
    ],
    "authors": [
        {
            "name": "Mitoera",
            "homepage": "https://github.com/todymic/mitoera-php-sdk"
        }
    ],
    "homepage": "https://github.com/todymic/mitoera-php-sdk",
    "support": {
        "issues": "https://github.com/todymic/mitoera-php-sdk/issues",
        "source": "https://github.com/todymic/mitoera-php-sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mitoera\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mitoera\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
